{
  "schema_version": "draft-1",
  "status": "illustrative_not_validated_by_runner",
  "adapter_id": "hybrid_wdt_pilot",
  "interfaces": [{"name": "regs", "kind": "tlm2_b_transport", "width_bits": 32, "outstanding_limit": 1}],
  "timing": {
    "style": "hybrid",
    "incoming_delay": "consumed_in_peq_readiness",
    "return_delay": "zero",
    "commit_rule": "first_rising_edge_strictly_after_peq_readiness",
    "temporal_decoupling": false,
    "reset": "synchronous_active_low_cancels_pending_access_at_original_completion_edge"
  },
  "capabilities": {"dmi": false, "debug_transport": false, "nonblocking_transport": false, "internal_probes": true},
  "events": ["submit", "peq_ready", "commit_read", "commit_write", "access_error", "reset_cancel", "reset", "expiry", "irq", "reset_request"],
  "qualification": {"rtl_correlated": false, "accepted_kpi_thresholds": null}
}

